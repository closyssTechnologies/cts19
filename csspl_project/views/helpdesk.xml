<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="helpdesk_ticket_form_view_inherit" model="ir.ui.view">
        <field name="name">helpdesk_ticket_form_view_inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_outgoing_transfer" string="Outgoing" class="btn btn-primary" type="object"/>
                <button name="action_create_incoming_transfer" string="Incoming" class="btn btn-primary" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_outgoing_transfer" string="Outgoing" class="oe_stat_button" icon="fa-truck" type="object"
                        invisible="count_outgoing_transfer == 0"/>
                <button name="action_view_incoming_transfer" string="Incoming" class="oe_stat_button" icon="fa-truck" type="object"
                        invisible="count_incoming_transfer == 0"/>
                <field name="count_outgoing_transfer" invisible="1"/>
                <field name="count_incoming_transfer" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="requester_name"/>
                <field name="project_name"/>
                <field name="receiver_name"/>
                <field name="receiver_no"/>
            </xpath>
        </field>
    </record>

    <record id="stock_wizard_form_view" model="ir.ui.view">
        <field name="name">stock_wizard_form_view</field>
        <field name="model">stock.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="helpdesk_id" invisible="1"/>
                            <field name="picking" invisible="1"/>
                            <field name="product_ids" widget="many2many_tags" placeholder="Select Multi Product"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="create_picking" type="object" string="Create Transfer" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>