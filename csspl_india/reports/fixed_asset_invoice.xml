<odoo>
    <record id="fixed_invoice_format_asset" model="report.paperformat">
        <field name="name">FIXED ASSET INVOICE</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="pdf_Fixed_report_invoice_asset" model="ir.actions.report">
        <field name="name">FIXED ASSET INVOICE</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customization.FIXED_tax_invoice_domestic_static</field>
        <field name="report_file">customization.FIXED_tax_invoice_domestic_static</field>
        <field name="print_report_name">'FIXED ASSET INVOICE - %s' %(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="fixed_invoice_format_asset"/>
        <field name="domain">[('status_in_payment','=','reversed')]</field>
        <field name="binding_type">report</field>

    </record>

    <template id="FIXED_tax_invoice_domestic_static">
       <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-call="customization.css_invoice_report_header_static">
                    <t t-set="l10n_in_edi_json" t-value="{}"/>

                    <t t-set="irn_no" t-value="l10n_in_edi_json.get('Irn', '')"/>
                    <t t-set="ack_no" t-value="l10n_in_edi_json.get('AckNo', '')"/>
                    <t t-set="ack_date" t-value="l10n_in_edi_json.get('AckDt', '')"/>

                    <t t-set="hsn_summary" t-value="doc._l10n_in_get_hsn_summary_table() if doc.company_id.account_fiscal_country_id.code == 'IN' else {}"/>
                    <t t-set="hsn_items" t-value="hsn_summary.get('items', [])"/>
                    <t t-set="hsn_show_sgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_cgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_igst" t-value="bool(hsn_summary.get('has_igst'))"/>
                    <t t-set="hsn_show_cess" t-value="bool(hsn_summary.get('has_cess'))"/>
                    <t t-set="hsn_sgst_total" t-value="sum((item.get('tax_amount_sgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cgst_total" t-value="sum((item.get('tax_amount_cgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_igst_total" t-value="sum((item.get('tax_amount_igst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cess_total" t-value="sum((item.get('tax_amount_cess', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="total_tax" t-value="(hsn_sgst_total or 0.0) + (hsn_cgst_total or 0.0) + (hsn_igst_total or 0.0) + (hsn_cess_total or 0.0)"/>
