                                    <th class="ti-col-hsn">HSN/SAC</th>
                                    <th class="ti-col-gst">GST Rate</th>
                                    <th class="ti-col-rate">Rate</th>
                                    <th class="ti-col-per">per</th>
                                    <th class="ti-col-amt">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
    <t t-set="sq_no" t-value="1"/>

    <t t-foreach="doc.invoice_line_ids" t-as="line">
        <t t-if="line.display_type == 'product'">

            <!-- PRODUCT ROW -->
            <tr>
                <td class="ti-text-center ti-v-top">
                    <span t-esc="sq_no"/>
                    <t t-set="sq_no" t-value="sq_no + 1"/>
                </td>
                <td class="ti-desc-cell">
                    <div class="ti-line-product" t-esc="line.product_id.name"/>
                    <t t-if="line.name and line.name != line.product_id.name">
                        <div class="ti-line-name" t-esc="line.name"/>
                    </t>

                </td>
                <td class="ti-text-center ti-v-top">
                    <span t-esc="line.l10n_in_hsn_code or ''"/>
                </td>
                <td class="ti-text-center ti-v-top">
                    <span t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                </td>
                <td class="ti-text-right ti-v-top">
                    <span t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                </td>
                <td class="ti-text-center ti-v-top">
                    <span t-esc="line.product_uom_id.name"/>
                </td>
                <td class="ti-text-right ti-v-top ti-bold">
                    <span t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                </td>
            </tr>

        </t>
    </t>

    <!-- TOTAL ROW -->
    <tr>
        <td colspan="6" class="ti-text-right ti-v-mid">Total</td>
        <td class="ti-text-right ti-bold">
            <span t-esc="doc.currency_id.symbol or ''"/>
            <span t-esc="doc.amount_total" t-options='{"widget": "float", "precision": 2}'/>
        </td>
    </tr>
</tbody>
                        </table>

                        <!-- AMOUNT WORDS -->
                                 <div style="padding:6px 8px 4px 8px; font-size:10px; line-height:1.28; border:1px solid black;">
                <span>Amount Chargeable (in words)</span>
                <div style="float:right; font-style:italic; white-space:nowrap;">E. &amp; O.E</div>
                <br/>
                <span style="font-size:11px; font-weight:bold;" t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
            </div>


<!-- HSN SUMMARY + TOTALS BESIDE -->
<table class="ti-hsn-totals-layout">
    <tr>
        <td class="ti-hsn-left-cell">
            <div class="ti-font-15 ti-bold" style="margin-bottom: 4px;">HSN Summary</div>

            <table class="ti-table ti-hsn-table">
                <thead>
                    <tr>
                        <th>HSN/SAC</th>
                        <th>Quantity</th>
                        <th>Rate %</th>
                        <th>Taxable Value</th>
                        <th t-if="hsn_show_sgst">SGST/UTGST</th>
                        <th t-if="hsn_show_cgst">CGST</th>
                        <th t-if="hsn_show_igst">IGST</th>
                        <th t-if="hsn_show_cess">CESS</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="hsn_summary.get('items')">
                        <t t-foreach="hsn_summary['items']" t-as="item">
                            <tr>
                                <td><span t-esc="item.get('l10n_in_hsn_code')"/></td>
                                <td>
                                    <span t-esc="item.get('quantity')"/>
                                    <span t-if="hsn_summary.get('display_uom')">
                                        (<t t-esc="item.get('uom_name')"/>)
                                    </span>
                                </td>
                                <td><span t-esc="item.get('rate')"/>%</td>
                                <td class="ti-text-right">
                                     <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(item.get('amount_untaxed', 0.0) or 0.0)"/>
                                </td>
                                <td class="ti-text-right" t-if="hsn_show_sgst">
                                     <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(item.get('tax_amount_sgst', 0.0) or 0.0)"/>
                                </td>
                                <td class="ti-text-right" t-if="hsn_show_cgst">
                                     <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(item.get('tax_amount_cgst', 0.0) or 0.0)"/>
                                </td>
                                <td class="ti-text-right" t-if="hsn_show_igst">
                                     <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(item.get('tax_amount_igst', 0.0) or 0.0)"/>
                                </td>
                                <td class="ti-text-right" t-if="hsn_show_cess">
                                     <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(item.get('tax_amount_cess', 0.0) or 0.0)"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <t t-else="">
                        <tr>
                            <td t-att-colspan="4 + (1 if hsn_show_sgst else 0) + (1 if hsn_show_cgst else 0) + (1 if hsn_show_igst else 0) + (1 if hsn_show_cess else 0)">
                                Summary not available
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </td>

        <td class="ti-hsn-right-cell">
            <table class="ti-table ti-hsn-table">
                <tr>
                    <td>Untaxed Amount:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(doc.amount_untaxed or 0.0)"/></td>
                </tr>
                <tr t-if="hsn_show_sgst">
                    <td>SGST:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(hsn_sgst_total or 0.0)"/></td>
                </tr>
                <tr t-if="hsn_show_cgst">
                    <td>CGST:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(hsn_cgst_total or 0.0)"/></td>
                </tr>
                <tr t-if="hsn_show_igst">
                    <td>IGST:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(hsn_igst_total or 0.0)"/></td>
                </tr>
                <tr t-if="hsn_show_cess">
                    <td>CESS:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(hsn_cess_total or 0.0)"/></td>
                </tr>
                <tr>
                    <td><strong>Total:</strong></td>
                    <td class="ti-text-right"><strong> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(doc.amount_total or 0.0)"/></strong></td>
                </tr>
                <tr>
                    <td>Paid:</td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format((doc.amount_total - doc.amount_residual) or 0.0)"/></td>
                </tr>
                <tr>
                    <td><strong>Balance Due:</strong></td>
                    <td class="ti-text-right"> <span t-esc="doc.currency_id.symbol or ''"/> <span t-esc="'{:,.2f}'.format(doc.amount_residual or 0.0)"/></td>
                </tr>
            </table>
        </td>
    </tr>
</table>


                        <!-- BOTTOM -->
<table style="width:100%; border-collapse:collapse; table-layout:fixed; margin-top:0;">
    <tr>
        <td style="border:1px solid #000; padding:0; vertical-align:top;">

            <!-- Tax amount in words -->
            <div style="padding:6px 8px 4px 8px; font-size:11px; line-height:1.28;">
                <span>Tax Amount (in words)</span>
                <span style="display:inline-block; width:16px; text-align:center;">:</span>
                <span style="font-size:12px; font-weight:bold;" t-esc="doc.currency_id.amount_to_text(total_tax)"/>
            </div>

            <!-- Main row: left (PAN) + right (bank + signatory) -->
            <div style="display:table; width:100%; table-layout:fixed; box-sizing:border-box;">

                <!-- LEFT: PAN -->
                <div style="display:table-cell; width:46%; vertical-align:bottom; padding:6px 8px 8px 8px; box-sizing:border-box;">
                    <div style="font-size:11px; line-height:1.22;">
                        <span style="display:inline-block; min-width:170px;">Company's PAN</span>
                        <span style="display:inline-block; width:16px; text-align:center;">:</span>
                        <span style="font-weight:bold; font-size:12px;" t-esc="doc.company_id.partner_id.l10n_in_pan_entity_id.name or ''"/>
                    </div>
                </div>

                <!-- RIGHT: Bank details + Signatory box -->
                <div style="display:table-cell; width:54%; vertical-align:bottom; padding:0; box-sizing:border-box;">

                    <!-- Bank details -->
                    <div style="padding:6px 8px 4px 8px; font-size:11px; line-height:1.22; box-sizing:border-box;">
                        <div style="font-weight:bold; margin-bottom:2px;">Company's Bank Details</div>
                        <div style="margin-bottom:1px;">

                            <span style="display:inline-block; width:150px;">Bank Name</span>
                            <span style="display:inline-block; width:16px; text-align:center;">:</span>
                            <span style="font-weight:bold;" t-esc="doc.partner_bank_id.bank_id.name or ''"/>
                        </div>
                        <div style="margin-bottom:1px;">
                            <span style="display:inline-block; width:150px;">A/c No.</span>
                            <span style="display:inline-block; width:16px; text-align:center;">:</span>
                            <span style="font-weight:bold;" t-esc="doc.partner_bank_id.acc_number or ''"/>
                        </div>
                        <div style="margin-bottom:1px;">
                            <span style="display:inline-block; width:150px;">Branch &amp; IFS Code</span>
                            <span style="display:inline-block; width:16px; text-align:center;">:</span>
                            <span style="font-weight:bold;" t-esc="(doc.partner_bank_id.bank_id.street or '') + ' ' + (doc.partner_bank_id.bank_id.bic or '')"/>
                        </div>
                    </div>

                    <!-- Signatory: left+top border only, Authorised Signatory pinned to bottom-right -->
                    <div style="border-left:1px solid #000; border-top:1px solid #000; min-height:90px; padding:4px 8px 4px 8px; box-sizing:border-box; width:100%; position:relative;">
                        <div style="font-size:11px; font-weight:bold; line-height:1.22;">
                            for <span t-esc="doc.company_id.partner_id.legal_name"/>
                        </div>
                        <div style="position:absolute; bottom:4px; right:8px; font-size:11px; line-height:1.2;">
                            Authorised Signatory
                        </div>
                    </div>

                </div>
            </div>

        </td>
    </tr>
</table>

            <div class="ti-footer-note">
                <div>SUBJECT TO MUMBAI JURISDICTION</div>
                <div>This is a Computer Generated Invoice</div>
            </div>



                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="css_invoice_report_header_static">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div t-attf-class="article o_report_layout_striped o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

</odoo>