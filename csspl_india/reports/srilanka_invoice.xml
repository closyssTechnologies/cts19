<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="csspl_srilanka_invoice_format" model="report.paperformat">
        <field name="name">Tax Invoice Sri Lanka</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="csspl_pdf_report_srilanka_invoice" model="ir.actions.report">
        <field name="name">TAX INVOICE SRI LANKA</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">csspl_india.tax_invoice_srilanka</field>
        <field name="report_file">csspl_india.tax_invoice_srilanka</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="csspl_srilanka_invoice_format"/>
        <field name="binding_type">report</field>
    </record>

    <template id="tax_invoice_srilanka">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="csspl_india.css_invoice_report_header_static">
<style>
    .sl-page {
<!--        font-family: 'DejaVu Sans', sans-serif;-->
        font-size: 16px;
        color: #000;
        line-height: 1.7;
        padding: 8px 12px;
    }

    /* TITLE */
    .sl-title-wrap {
        text-align: center;
        margin-bottom: 16px;
    }
    .sl-title-box {
        display: inline-block;
        border: 1.5px solid #000;
        padding: 6px 36px;
        font-size: 16px;
        font-weight: bold;
        letter-spacing: 0.5px;
    }

.sl-two-col {
    width: 100%;
    margin-bottom: 10px;
    box-sizing: border-box;
    overflow: hidden;
}

.sl-col-left {
    float: left;
    width: 49.5%;
    border: 1px solid #000;
    padding: 10px 12px;
    font-size: 14px !important;
    box-sizing: border-box;
    vertical-align: top;
}

.sl-col-right {
    float: right;
    width: 49.5%;
    border: 1px solid #000;
    padding: 10px 12px;
    font-size: 14px !important;
    box-sizing: border-box;
    vertical-align: top;
}

/* clearfix */
.sl-two-col:after {
    content: "";
    display: block;
    clear: both;
}

    /* ADDITIONAL INFO */
    .sl-additional {
        border: 1px solid #000;
        padding: 10px 12px;
        min-height: 62px;
        font-size: 14px;
        margin-bottom: 20px;
        box-sizing: border-box;
    }

    /* PARTY LINES */
    .sl-line {
        margin-bottom: 4px;
        font-size: 14px;
    }
    .sl-line-gap {
        margin-top: 10px;
        font-size: 14px;
    }

    /* LINE ITEMS TABLE */
    .sl-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-bottom: 20px;
    }
    .sl-table th {
        border: 1px solid #000;
        padding: 7px 6px;
        font-size: 14px;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
    }
    .sl-table td {
        border: 1px solid #000;
        padding: 6px 7px;
        font-size: 14px;
        vertical-align: top;
        word-break: break-word;
    }

    .sl-col-ref  { width: 12%; }
    .sl-col-desc { width: 43%; }
    .sl-col-qty  { width: 11%; }
    .sl-col-unit { width: 14%; }
    .sl-col-amt  { width: 20%; }

    .sl-text-center { text-align: center; }
    .sl-text-right  { text-align: right; }
    .sl-bold        { font-weight: bold; }
    .sl-v-mid       { vertical-align: middle; }
    .sl-v-top       { vertical-align: top; }
    .sl-italic      { font-style: italic; }

    .sl-empty-row td { height: 24px; }

    .sl-total-label {
        padding: 6px 8px;
        font-size: 14px;
        vertical-align: middle;
    }
    .sl-total-value {
        padding: 6px 8px;
        font-size: 14px;
        text-align: right;
        vertical-align: middle;
    }

    /* BOTTOM SECTION — ONLY HORIZONTAL BORDER */
    .sl-bottom-wrap {
        border: 1px solid #000;
        margin-bottom: 12px;
    }
    .sl-bottom-row {
        padding: 8px 10px;
        font-size: 14px;
        border-bottom: 1px solid #000;
        box-sizing: border-box;
    }
    .sl-bottom-row:last-child {
        border-bottom: none;
    }

    /* EOG + FOOTER */
    .sl-eog {
        font-size: 13px;
        margin-top: 10px;
        margin-bottom: 6px;
    }
    .sl-footer-line {
        border-top: 2px solid #000;
        text-align: center;
        font-size: 12px;
        padding-top: 5px;
        margin-top: 4px;
    }


</style>

<div class="page sl-page">

    <!-- TITLE -->
    <div class="sl-title-wrap">
        <div class="sl-title-box">Tax Invoice</div>
    </div>

    <!-- ROW 1: Date of Invoice | Tax Invoice No. -->
    <div class="sl-two-col">
        <div class="sl-col-left">
            Date of Invoice: <span t-esc="doc.invoice_date" t-options="{'widget': 'date'}"/>
        </div>
        <div class="sl-col-right">
            Tax Invoice No.: <span t-esc="doc.name"/>
        </div>
    </div>

    <!-- ROW 2: Supplier | Purchaser -->
    <div class="sl-two-col">

    <!-- SUPPLIER -->
    <div class="sl-col-left">
        <div class="sl-line">
            Supplier's TIN:
            <span t-esc="doc.company_id.vat or ''"/>
        </div>

        <div class="sl-line">
            Supplier's Name:
            <span t-esc="(doc.company_id.name or '').title()"/>
        </div>

            <div class="sl-line" style="min-height:80px">
    Address:
    <span t-esc="(doc.company_id.partner_id.street or '').title()"/>
    <t t-if="doc.company_id.partner_id.street2">
        , <span t-esc="(doc.company_id.partner_id.street2 or '').title()"/>
    </t>
    <t t-if="doc.company_id.partner_id.zip">
        - <span t-esc="doc.company_id.partner_id.zip"/>
    </t>
    <t t-if="doc.company_id.partner_id.state_id">
        , <span t-esc="(doc.company_id.partner_id.state_id.name or '').title()"/>
    </t>
    <t t-if="doc.company_id.partner_id.country_id">
        , <span t-esc="(doc.company_id.partner_id.country_id.name or '').title()"/>
    </t>
</div>


        <div class="sl-line-gap">
            Telephone No:
            <span t-esc="doc.company_id.phone or ''"/>
        </div>
    </div>

    <!-- PURCHASER -->
    <div class="sl-col-right">
        <div class="sl-line">
            Purchaser's TIN:
            <span t-esc="doc.partner_id.vat or ''"/>
        </div>

        <div class="sl-line">
            Purchaser's Name:
            <t t-if="doc.partner_id.parent_id.name">
                <span t-esc="(doc.partner_id.parent_id.name or '').title()"/>
            </t>
            <t t-else="">
                <span t-esc="(doc.partner_id.name or '').title()"/>
            </t>
        </div>

    <div class="sl-line" style="min-height:80px">
    Address:
    <span t-esc="(doc.partner_id.street or '').title()"/>
    <t t-if="doc.partner_id.street2">
        , <span t-esc="(doc.partner_id.street2 or '').title()"/>
    </t>
    <t t-if="doc.partner_id.zip">
        - <span t-esc="doc.partner_id.zip"/>
    </t>
    <t t-if="doc.partner_id.state_id">
        , <span t-esc="(doc.partner_id.state_id.name or '').title()"/>
    </t>
    <t t-if="doc.partner_id.country_id">
        , <span t-esc="(doc.partner_id.country_id.name or '').title()"/>
    </t>
</div>

        <div class="sl-line-gap">
            Telephone No:
            <span t-esc="doc.partner_id.phone or ''"/>
        </div>
    </div>

</div>

    <!-- ROW 3: Date of Delivery | Place of Supply -->
    <div class="sl-two-col">
        <div class="sl-col-left">
            Date of Delivery:
            <span t-esc="doc.invoice_date_due" t-options="{'widget': 'date'}"/>
        </div>
        <div class="sl-col-right">
            Place of Supply: <span t-esc="doc.partner_id.city or ''"/>
        </div>
    </div>

    <!-- ROW 4: Additional Information -->
    <div class="sl-additional">
        Additional Information if any: <span t-esc="doc.narration or ''"/>
    </div>

    <!-- LINE ITEMS TABLE -->
    <table class="sl-table">
        <thead>
            <tr>
                <th class="sl-col-ref">Reference</th>
                <th class="sl-col-desc">Description of Goods or Services</th>
                <th class="sl-col-qty">Quantity</th>
                <th class="sl-col-unit">Unit Price</th>
                <th class="sl-col-amt">Amount<br/>Excluding VAT<br/>(Rs.)</th>
            </tr>
        </thead>
        <tbody>
            <t t-set="sq_no" t-value="1"/>
            <t t-foreach="doc.invoice_line_ids" t-as="line">
                <t t-if="line.display_type == 'product'">
                    <tr>
                        <td class="sl-text-center sl-v-top">
                            <span t-esc="sq_no"/>
                            <t t-set="sq_no" t-value="sq_no + 1"/>
                        </td>
                        <td class="sl-v-top">
                            <div class="sl-bold" t-esc="line.product_id.name or ''"/>
                            <t t-if="line.name and line.name != line.product_id.name">
                                <div class="sl-italic" style="font-size: 13px;"
                                     t-esc="line.name"/>
                            </t>
                        </td>
                        <td class="sl-text-center sl-v-top">
                            <span t-esc="line.quantity"
                                  t-options='{"widget": "float", "precision": 2}'/>
                            <br/>
                            <span t-esc="line.product_uom_id.name or ''"/>
                        </td>
                        <td class="sl-text-right sl-v-top">
                            <span t-esc="line.price_unit"
                                  t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                        <td class="sl-text-right sl-v-top">
                            <span t-esc="line.price_subtotal"
                                  t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                </t>
            </t>

            <!-- Empty rows -->
            <tr class="sl-empty-row">
                <td></td><td></td><td></td><td></td><td></td>
            </tr>
            <tr class="sl-empty-row">
                <td></td><td></td><td></td><td></td><td></td>
            </tr>
            <tr class="sl-empty-row">
                <td></td><td></td><td></td><td></td><td></td>
            </tr>

            <!-- Totals -->
            <tr>
                <td colspan="4" class="sl-total-label">Total Value of Supply:</td>
                <td class="sl-total-value">
                    <span t-esc="doc.amount_untaxed"
                          t-options='{"widget": "float", "precision": 2}'/>
                </td>
            </tr>
            <tr>
                <td colspan="4" class="sl-total-label">
                    VAT Amount (Total Value of Supply @ 18%)
                </td>
                <td class="sl-total-value">
                    <span t-esc="doc.amount_tax"
                          t-options='{"widget": "float", "precision": 2}'/>
                </td>
            </tr>
            <tr>
                <td colspan="4" class="sl-total-label sl-bold">
                    Total Amount including VAT:
                </td>
                <td class="sl-total-value sl-bold">
                    <span t-esc="doc.amount_total"
                          t-options='{"widget": "float", "precision": 2}'/>
                </td>
            </tr>
        </tbody>
    </table>


    <div class="sl-bottom-wrap">
        <div class="sl-bottom-row">
            Total Amount in words:
            <span class="sl-bold"
                  t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
        </div>
        <div class="sl-bottom-row">
            Mode of Payment:
            <span t-esc="doc.invoice_payment_term_id.name or ''"/>
        </div>
    </div>

    <!-- EOG -->
    <div class="sl-eog">EOG 11 - 0124</div>

    <!-- FOOTER -->
    <div class="sl-footer-line">
        PRINTED AT THE DEPARTMENT OF GOVERNMENT PRINTING, SRI LANKA.
    </div>

</div>
                </t>
            </t>
        </t>
    </template>
</odoo>