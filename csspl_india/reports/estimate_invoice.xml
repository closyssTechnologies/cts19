<t t-name="customization.estimate_invoice_report_document">
            <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="customization.css_export_invoice_report_layout">

                    <t t-set="hsn_summary" t-value="doc._l10n_in_get_hsn_summary_table() if doc.company_id.account_fiscal_country_id.code == 'IN' else {}"/>
                    <t t-set="hsn_items" t-value="hsn_summary.get('items', [])"/>
                    <t t-set="hsn_show_sgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_cgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_igst" t-value="bool(hsn_summary.get('has_igst'))"/>
                    <t t-set="hsn_show_cess" t-value="bool(hsn_summary.get('has_cess'))"/>

                    <t t-set="hsn_sgst_total" t-value="sum((item.get('tax_amount_sgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cgst_total" t-value="sum((item.get('tax_amount_cgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_igst_total" t-value="sum((item.get('tax_amount_igst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cess_total" t-value="sum((item.get('tax_amount_cess', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="total_tax" t-value="(hsn_sgst_total or 0.0) + (hsn_cgst_total or 0.0) + (hsn_igst_total or 0.0) + (hsn_cess_total or 0.0)"/>

