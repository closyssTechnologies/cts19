<t t-name="customization.report_other_invoice_document">
        <t t-call="web.html_container">
            <meta charset="UTF-8"/>
            <style type="text/css">
                .invoice-container {
                    font-family: 'DejaVu Sans', sans-serif;
                    font-size: 11px;
                    color: #000;
                    width: 100%;
                }
                .text-center { text-align: center; }
                .text-right { text-align: right; }
                .text-left { text-align: left; }
                .font-bold { font-weight: bold; }

                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 5px;
                }
                .bordered table, .bordered th, .bordered td {
                    border: 1px solid black;
                }
                th, td {
                    padding: 4px;
                    vertical-align: top;
                }

                .header-table td { border: none !important; }
                .logo-box {
                    border: 1px solid black;
                    width: 150px;
                    height: 80px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                }

                .totals-box {
                    width: 40%;
                    float: right;
                    border: 1px solid black;
                }
                .totals-box td { border: 1px solid black; }

                .footer-section {
                    margin-top: 35px;
                }

                .signature-line {
                    border-top: 1px solid black;
                    width: 200px;
                    margin-top: 50px;
                    float: right;
                    text-align: center;
                }

                .page-footer {
                    position: fixed;
                    bottom: 10px;
                    width: 100%;
                    text-align: center;
                    font-size: 10px;
                    border-top: 1px solid black;
                    padding-top: 5px;
                }
            </style>

            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="invoice-container">
                        <!-- Title Section -->
                        <div class="text-center font-bold" style="font-size: 16px; margin-bottom: 20px; text-transform: uppercase;">
                            <t t-if="o.move_type == 'out_invoice'">TAX INVOICE</t>
                            <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                            <t t-else="">TAX INVOICE / CREDIT NOTE</t>
                        </div>

                        <!-- Header Table: Logo Left, Company Center, Client Right -->
                        <table>
                            <tr>
                                <td style="width: 30%;">
                                    <div class="logo-box">
                                        <t t-if="o.company_id.logo">
                                            <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 70px; max-width: 140px;"/>
                                        </t>
                                        <t t-else="">
                                            <strong>QCS Logo</strong>
                                        </t>
                                    </div>
                                </td>
                                <td style="width: 35%;" class="text-left">
                                    <div class="font-bold"><span t-field="o.company_id.name"/></div>
                                    <div><span t-field="o.company_id.partner_id.contact_address"/></div>
                                    <div style="margin-top: 5px;">Company VAT: <span t-field="o.company_id.vat"/></div>
                                    <div>Company E-mail: <span t-field="o.company_id.email"/></div>
                                    <div>Registration Number: <span t-field="o.company_id.company_registry"/></div>
                                </td>
                                <td style="width: 35%;" class="text-right">
                                    <div class="font-bold">CLIENT DETAILS</div>
                                    <div class="font-bold"><span t-field="o.partner_id.name"/></div>
                                    <div><span t-field="o.partner_id.contact_address"/></div>
                                    <div style="margin-top: 5px;">Client GSTIN/VAT: <span t-field="o.partner_id.vat"/></div>
                                    <div>Place of Supply: <span t-esc="o.partner_id.state_id.name or 'N/A'"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Invoice Info Table -->
                        <div style="margin-top: 15px;">
                            <div class="font-bold">Invoice Number: <span t-field="o.name"/></div>
                            <table class="bordered" style="margin-top: 5px;">
                                <tr class="text-center font-bold">
                                    <td style="width: 15%;">Invoice Date</td>
                                    <td style="width: 15%;">Buyer Order No</td>
                                    <td style="width: 15%;">Due Date</td>
                                    <td style="width: 15%;">Credit Note No.</td>
                                    <td style="width: 20%;">Other References:</td>
                                    <td style="width: 20%;">Conversion Rate:</td>
                                </tr>
                                <tr class="text-center">
                                    <td><span t-field="o.invoice_date"/></td>
                                    <td><span t-field="o.invoice_origin"/></td>
                                    <td><span t-field="o.invoice_date_due"/></td>
                                    <td><span t-field="o.reversed_entry_id.name"/></td>
                                    <td><span t-field="o.ref"/></td>
                                    <td>
                                        <t t-if="o.currency_id != o.company_id.currency_id">
                                            1 <span t-field="o.currency_id.name"/> = <span t-esc="'%.2f' % o.inverse_invoice_currency_rate"/> <span t-field="o.company_id.currency_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Line Items Table -->
                        <table class="bordered" style="margin-top: 15px;">
    <thead>
        <tr class="text-center font-bold">
            <td style="width: 7%;">Sr No</td>
            <td style="width: 43%;">Description</td>
            <td style="width: 10%;">Quantity</td>
            <td style="width: 9%;">Unit Price</td>
            <td style="width: 15%;">Taxes</td>
            <td style="width: 16%;">Amount</td>
        </tr>
    </thead>
    <tbody>
    <t t-set="i" t-value="1"/>

    <t t-foreach="o.invoice_line_ids" t-as="line">
        <tr>
            <td class="text-center">
                <span t-esc="i"/>
            </td>

            <td>
                <span t-field="line.name"/>
            </td>

            <td class="text-right">
                <span t-field="line.quantity"/>
            </td>

            <td class="text-right">
                <span t-field="line.price_unit"
      t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
            </td>

            <td class="text-center">
                <span t-esc="', '.join(line.tax_ids.mapped('name')) if line.tax_ids else ''"/>
            </td>

            <td class="text-right">
                <span t-field="line.price_subtotal"
      t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
            </td>
        </tr>

        <t t-set="i" t-value="i+1"/>
    </t>

    <t t-if="len(o.invoice_line_ids.filtered(lambda l: not l.display_type)) &lt; 5">
        <tr style="height: 50px;">
            <td/><td/><td/><td/><td/><td/>
        </tr>
    </t>
</tbody>
</table>

                        <!-- Totals and Words Section -->
                        <div style="margin-top: 15px;">
                            <div style="float: left; width: 60%;">
                                <div class="font-bold">Total Amount in Words: <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/></div>
                                <div style="margin-top: 20px;">Tax Amount in Words: <span t-esc="o.currency_id.amount_to_text(o.amount_tax)"/></div>
                            </div>

                            <table class="totals-box bordered">
    <tr>
        <td>Untaxed Amount:</td>
        <td class="text-right">
            <span t-field="o.amount_untaxed"
                  t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
        </td>
    </tr>

    <tr>
        <td>VAT:</td>
        <td class="text-right">
            <span t-field="o.amount_tax"
                  t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
        </td>
    </tr>

    <tr class="font-bold">
        <td>Total:</td>
        <td class="text-right">
            <span t-field="o.amount_total"
                  t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
        </td>
    </tr>

    <tr>
        <td>Paid:</td>
            <td class="text-right nowrap">
                <span t-esc="o.amount_total - o.amount_residual"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
    </tr>

    <tr class="font-bold">
        <td>Amount Due:</td>
        <td class="text-right">
            <span t-field="o.amount_residual"
                  t-options='{"widget":"monetary","display_currency": o.currency_id}'/>
        </td>
    </tr>
</table>
                            <div style="clear: both;"/>
                        </div>

                        <!-- Bank and Footer Section -->
                        <div class="footer-section">
                            <div style="float: left; width: 50%;">
                                <div>VAT Registration Number(UK):</div>
                                <div>GST Registration Number(Singapore):</div>
                                <div>Local Sales Tax No(Sri Lanka):</div>
                                <div style="margin-top: 5px;">Declaration:</div>
                                <div style="font-size: 9px; margin-top: 2px;">
                                    We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.
                                </div>
                            </div>
                            <div style="float: right; width: 45%;">
                                <div class="font-bold">Company Bank Details</div>
                                <div>Bank Name: <t t-if="o.company_id.bank_ids" t-esc="o.company_id.bank_ids[0].bank_id.name"/></div>
                                <div>Account No: <t t-if="o.company_id.bank_ids" t-esc="o.company_id.bank_ids[0].acc_number"/></div>
                                <div>Branch &amp; IFSC Code: <t t-if="o.company_id.bank_ids" t-esc="o.company_id.bank_ids[0].bank_id.bic"/></div>
                                <div>SWIFT Code:(for export/SEZ)</div>

                                <div style="margin-top: 20px;">
                                    <div>Company Name: <span t-field="o.company_id.name"/></div>
                                    <div>Company Address: <span t-field="o.company_id.partner_id.contact_address"/></div>
                                </div>

                                <div class="signature-line">
                                    <strong>Authorized Signatory</strong>
                                </div>
                            </div>
                            <div style="clear: both;"/>
                        </div>
                    </div>
                </div>

                <div class="page-footer">
                    Terms &amp; Conditions
                </div>
            </t>
        </t>
    </t>