    overflow-wrap: anywhere;
}

.ex-tax-label { text-align: right; font-weight: bold; padding-right: 16px; }
.ex-tax-rate  { text-align: center; width: 34px; }
.ex-tax-pct   { text-align: center; width: 24px; }
.ex-tax-amt   { text-align: right; width: 110px; font-weight: bold; }

/* ============================================================
   AMOUNT NOWRAP
   Single concatenated span = symbol+number never split
   ============================================================ */
.ex-amount-nowrap {
    white-space: nowrap !important;
    word-break: keep-all !important;
    overflow-wrap: normal !important;
}

/* ============================================================
   UNTAXED / TOTALS TABLE
   FIX: float:right + overflow:hidden wrapper — NOT margin:auto
   ============================================================ */
.ex-untaxed-wrapper {
    width: 100%;
    overflow: hidden;  /* clearfix */
    margin-top: 3%;
    margin-bottom: 3%;
}

.ex-untaxed-table {
    float: right !important;
    width: 50% !important;
    border-collapse: collapse;
    table-layout: fixed;
    /* margin:auto removed — wkhtmltopdf ignores it */
}

.ex-untaxed-table td {
    border: 1px solid #000;
    padding: 6px 7px;
    font-size: 10px;
    line-height: 1.25;
    vertical-align: middle;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
    box-sizing: border-box;
}

.ex-untaxed-table td:first-child { width: 60%; }
.ex-untaxed-table td:last-child  {
    width: 40%;
    text-align: right;
    white-space: nowrap !important;
    word-break: keep-all !important;
    overflow-wrap: normal !important;
}

/* ============================================================
   AMOUNT WORDS
   ============================================================ */
.ex-amount-words td {
    padding: 7px 8px !important;
    font-size: 10px;
}

/* float:right removed from .ex-eoe — use nested table instead */
.ex-eoe { font-style: italic; }

/* ============================================================
   BOTTOM BANK / SIGNATURE
   ============================================================ */
.ex-export-final-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: 0;
}

.ex-export-final-table td {
    border: 1px solid #000;
    vertical-align: top;
    padding: 6px 8px;
    box-sizing: border-box;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.ex-export-final-single {
    position: relative;
    min-height: 145px;
}

.ex-export-pan-line {
    font-size: 10px;
    line-height: 1.22;
    margin-bottom: 4px;
    width: 56%;
}

.ex-export-bank-title {
    font-size: 10px;
    font-weight: bold;
    margin-top: 3px;
    margin-bottom: 2px;
    width: 56%;
}

.ex-export-bank-row {
    font-size: 10px;
    line-height: 1.18;
