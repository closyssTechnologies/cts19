<odoo>

    <record id="css_dubai_chocolate_invoice_format" model="report.paperformat">
        <field name="name">Dubai Chocolate Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="dubai_chocolate_invoice_report" model="ir.actions.report">
        <field name="name">Dubai Chocolate Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customization.dubai_chocolate_invoice_report_document</field>
        <field name="report_file">customization.dubai_chocolate_invoice_report_document</field>
        <field name="print_report_name">'Dubai Chocolate Invoice - %s' %(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="customization.css_dubai_chocolate_invoice_format"/>
        <field name="binding_type">report</field>
    </record>

    <template id="dubai_chocolate_invoice_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="customization.css_export_invoice_report_layout">

                    <t t-set="company_bank" t-value="doc.company_id.bank_ids and doc.company_id.bank_ids[0] or False"/>
                    <t t-set="swift_code" t-value="company_bank and company_bank.bank_id.bic or ''"/>

                    <t t-set="hsn_summary" t-value="doc._l10n_in_get_hsn_summary_table() if doc.company_id.account_fiscal_country_id.code == 'IN' else {}"/>
                    <t t-set="hsn_items" t-value="hsn_summary.get('items', [])"/>
                    <t t-set="hsn_show_sgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_cgst" t-value="bool(hsn_summary.get('has_gst'))"/>
                    <t t-set="hsn_show_igst" t-value="bool(hsn_summary.get('has_igst'))"/>
                    <t t-set="hsn_show_cess" t-value="bool(hsn_summary.get('has_cess'))"/>

                    <t t-set="hsn_sgst_total" t-value="sum((item.get('tax_amount_sgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cgst_total" t-value="sum((item.get('tax_amount_cgst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_igst_total" t-value="sum((item.get('tax_amount_igst', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="hsn_cess_total" t-value="sum((item.get('tax_amount_cess', 0.0) or 0.0) for item in hsn_items)"/>
                    <t t-set="total_tax" t-value="(hsn_sgst_total or 0.0) + (hsn_cgst_total or 0.0) + (hsn_igst_total or 0.0) + (hsn_cess_total or 0.0)"/>

<style>
/* ============================================================
   BASE
   ============================================================ */
.ex-page {
    font-family: 'DejaVu Sans', sans-serif;
    font-size: 10px;
    color: #000;
    line-height: 1.30;
}

