                                                <span class="ex-right-grid-value" t-esc="doc.name or ''"/>
                                            </td>
                                            <td class="ex-v-top">
                                                <span class="ex-right-grid-label">Dated</span>
                                                <span class="ex-right-grid-value" t-esc="doc.invoice_date" t-options="{'widget': 'date'}"/>
