                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <t t-if="line.display_type == 'product'">
                                        <tr>
                                            <!-- col 1: serial -->
                                            <td class="ex-text-center ex-v-top">
                                                <span t-esc="sq_no"/>
                                                <t t-set="sq_no" t-value="sq_no + 1"/>
                                            </td>

                                            <!-- col 2: description -->
                                            <td class="ex-desc-cell">
                                                <div class="ex-line-product" t-esc="line.product_id.name"/>
                                                <t t-if="line.name and line.name != line.product_id.name">
                                                    <div class="ex-line-name" t-esc="line.name"/>
                                                </t>
                                            </td>

                                            <!-- col 3: amount — single span, never splits symbol from number -->
                                            <td class="ex-text-right ex-v-top ex-amount-nowrap ex-bold">
                                                <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(line.price_unit or 0.0)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- TOTAL ROW: exactly 3 cells -->
                                <tr class="ex-bold">
                                    <td class="ex-text-center"/>
                                    <td class="ex-text-right">Total</td>
                                    <td class="ex-text-right ex-bold ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(doc.amount_untaxed or 0.0)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ========== UNTAXED / TOTALS TABLE ==========
                             FIX: float:right wrapper — NOT margin:auto
                             This table has exactly 2 columns.
                        =============================================== -->
                        <div class="ex-untaxed-wrapper">
                            <table class="ex-untaxed-table">
                                <tr>
                                    <td>Untaxed Amount:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(doc.amount_untaxed or 0.0)"/>
                                    </td>
                                </tr>

                                <tr t-if="hsn_show_sgst">
                                    <td>SGST:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(hsn_sgst_total or 0.0)"/>
                                    </td>
                                </tr>

                                <tr t-if="hsn_show_cgst">
                                    <td>CGST:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(hsn_cgst_total or 0.0)"/>
                                    </td>
                                </tr>

                                <tr t-if="hsn_show_igst">
                                    <td>IGST:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(hsn_igst_total or 0.0)"/>
                                    </td>
                                </tr>

                                <tr t-if="hsn_show_cess">
                                    <td>CESS:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(hsn_cess_total or 0.0)"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Total:</strong></td>
                                    <td class="ex-text-right ex-bold ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(doc.amount_total or 0.0)"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Paid:</td>
                                    <td class="ex-text-right ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format((doc.amount_total - doc.amount_residual) or 0.0)"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Balance Due:</strong></td>
                                    <td class="ex-text-right ex-bold ex-amount-nowrap">
                                        <span t-esc="(doc.currency_id.symbol or '') + ' ' + '{:,.2f}'.format(doc.amount_residual or 0.0)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- clearfix after float -->
                        <div style="clear:both;"/>

                        <!-- ========== BOTTOM: AMOUNT WORDS + BANK + SIGN ==========
                             FIX: E. & O.E uses &#160; (non-breaking space) around &
                             FIX: nested 2-col table replaces float:right on span
                             FIX: bank + sign use float:right with clear:both
                        ============================================================ -->
                        <table class="ti-table ti-bottom-joined-table">
                            <tr>
                                <td class="ti-bottom-joined-cell">

                                    <!-- Amount in words: nested 2-col table -->
                                    <table style="width:100%; border-collapse:collapse; table-layout:fixed; border:none; margin-bottom:6px;">
                                        <tr>
                                            <td style="border:none; padding:0; text-align:left; vertical-align:top; width:70%; font-size:14px;">
                                                Amount Chargeable (in words)
                                            </td>
                                            <td style="border:none; padding:0; text-align:right; vertical-align:top; width:30%; white-space:nowrap; word-break:keep-all; overflow-wrap:normal;">
                                                <!-- &#160; = non-breaking space: E. & O.E will never split -->
                                                <span style="font-style:italic; white-space:nowrap; word-break:keep-all;">E. &amp; O.E</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="border:none; padding:0; padding-top:4px;">
                                                <span style="font-size:11px; font-weight:bold; line-height:1.18;" t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
                                            </td>
                                        </tr>
                                    </table>

                                    <!-- Bank details: float:right -->
                                    <div class="ti-bottom-bank-outside">
                                        <div class="ti-bank-title">Company's Bank Details</div>

                                        <div class="ti-bank-row">
                                            <span class="ti-bank-label">A/c Holder's Name</span>
                                            <span class="ti-bank-colon">:</span>
                                            <span class="ti-bank-value" t-esc="doc.company_id.name or ''"/>
                                        </div>

                                        <div class="ti-bank-row">
                                            <span class="ti-bank-label">Bank Name</span>
                                            <span class="ti-bank-colon">:</span>
                                            <span class="ti-bank-value" t-esc="doc.partner_bank_id.bank_id.name or ''"/>
                                        </div>

                                        <div class="ti-bank-row">
                                            <span class="ti-bank-label">A/c No.</span>
                                            <span class="ti-bank-colon">:</span>
                                            <span class="ti-bank-value" t-esc="doc.partner_bank_id.acc_number or ''"/>
                                        </div>

                                        <div class="ti-bank-row">
                                            <span class="ti-bank-label">Branch &amp; Bank Code</span>
                                            <span class="ti-bank-colon">:</span>
                                            <span class="ti-bank-value" t-esc="(doc.partner_bank_id.bank_id.street or '') + ' ' + (doc.partner_bank_id.bank_id.bic or '')"/>
                                        </div>

                                        <div class="ti-bank-row">
                                            <span class="ti-bank-label">SWIFT Code</span>
                                            <span class="ti-bank-colon">:</span>
                                            <span class="ti-bank-value" t-esc="swift_code or ''"/>
                                        </div>
                                    </div>


                       <!-- Signatory: left+top border only, stuck to bottom-right -->
                                    <div style="float:right; width:54%; border-left:1px solid #000; border-top:1px solid #000; min-height:90px; padding:4px 8px 4px 8px; box-sizing:border-box;">
    <div style="font-size:10px; font-weight:bold; line-height:1.22;">
        for <span t-esc="doc.company_id.partner_id.legal_name"/>
    </div>
    <div style="height:70px;"/>
    <div style="text-align:right; font-size:10px; line-height:1.2; padding-right:0;">
        Authorised Signatory
    </div>
</div>
            <div style="clear:both;"/>

                                </td>
                            </tr>
                        </table>

                        <!-- ========== FOOTER ========== -->
                        <div class="ex-footer-note">
                            <div style="margin-top:1%">SUBJECT TO UNITED ARAB EMIRATES JURISDICTION</div>
                            <div style="margin-top:1%">This is a Computer Generated Document</div>
                        </div>

                    </div><!-- end .page.ex-page -->

                </t>
            </t>
        </t>
    </template>

</odoo>