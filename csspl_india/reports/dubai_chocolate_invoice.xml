.ex-v-mid { vertical-align: middle; }
.ex-bold  { font-weight: bold; }
.ex-italic { font-style: italic; }

.ex-font-14 { font-size: 10px; }
.ex-font-15 { font-size: 11px; }
.ex-font-16 { font-size: 11px; }
.ex-font-17 { font-size: 12px; }
.ex-font-21 { font-size: 17px; }

.ex-mt-2 { margin-top: 2px; }
.ex-mt-4 { margin-top: 4px; }
.ex-mt-6 { margin-top: 6px; }
.ex-mt-8 { margin-top: 8px; }

/* ============================================================
