        <span t-esc="doc.amount_total" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
    </td>
</tr>
                            </tbody>
                        </table>

                        <!-- KEEP UNTOUCHED -->
                        <table class="ex-table ex-untaxed-table">
                            <tr>
                                <td>Untaxed Amount:</td>
<td class="ex-text-right ex-amount-nowrap">
    <span t-esc="doc.currency_id.symbol or ''"/>
    <span t-esc="'{:,.2f}'.format(doc.amount_untaxed or 0.0)"/>
</td>
                            </tr>

                            <tr t-if="hsn_show_sgst ">
                                <td>SGST:</td>
                                <td class="ex-text-right  ex-amount-nowrap">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format(hsn_sgst_total or 0.0)"/>
                                </td>
                            </tr>

                            <tr t-if="hsn_show_cgst">
                                <td>CGST:</td>
                                <td class="ex-text-right  ex-amount-nowrap">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format(hsn_cgst_total or 0.0)"/>
                                </td>
                            </tr>

                            <tr t-if="hsn_show_igst">
                                <td>IGST:</td>
                                <td class="ex-text-right  ex-amount-nowrap">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format(hsn_igst_total or 0.0)"/>
                                </td>
                            </tr>

                            <tr t-if="hsn_show_cess">
                                <td>CESS:</td>
                                <td class="ex-text-right  ex-amount-nowrap">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format(hsn_cess_total or 0.0)"/>
                                </td>
                            </tr>

                            <tr>
                                <td><strong>Total:</strong></td>
<td class="ex-text-right ex-bold ex-amount-nowrap">
    <span t-esc="doc.currency_id.symbol or ''"/>
    <span t-esc="'{:,.2f}'.format(doc.amount_total or 0.0)"/>
</td>
                            </tr>

                            <tr>
                                <td>Paid:</td>
                                <td class="ex-text-right">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format((doc.amount_total - doc.amount_residual) or 0.0)"/>
                                </td>
                            </tr>

                            <tr>
                                <td><strong>Balance Due:</strong></td>
                                <td class="ex-text-right ex-bold">
                                    <span t-esc="doc.currency_id.symbol or ''"/>
                                    <span t-esc="'{:,.2f}'.format(doc.amount_residual or 0.0)"/>
                                </td>
                            </tr>
                        </table>

                        <!-- AMOUNT WORDS -->
                        <table class="ex-table ex-amount-words">
                            <tr>
                                <td>
                                    <span>Amount Chargeable (in words)</span>
                                    <span class="ex-eoe">E. &amp; O.E</span>
                                    <br/>
                                    <span class="ex-bold ex-font-15" t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
                                </td>
                            </tr>
                        </table>

                        <!-- LOWER SECTION -->
                        <table class="ex-table ex-export-final-table">
                            <tr>
                                <td class="ex-export-final-single">
                                    <div class="ex-export-pan-line" style="margin-top:3%">
                                        VAT Regn. No.:
                                        <span class="ex-bold" t-esc="doc.company_id.vat or ''"/>
                                    </div>

                                    <div class="ex-export-pan-line">Declaration</div>

                                    <div class="ex-export-bank-title">BANK DETAILS</div>

                                    <div class="ex-export-bank-row">
                                        Bank Name:
                                        <span t-esc="doc.partner_bank_id.bank_id.name or ''"/>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        Bank Address:
                                        <span t-esc="doc.partner_bank_id.bank_id.street or ''"/>
                                        <t t-if="doc.partner_bank_id.bank_id.city">, <span t-esc="doc.partner_bank_id.bank_id.city"/></t>
                                        <t t-if="doc.partner_bank_id.bank_id.country">, <span t-esc="doc.partner_bank_id.bank_id.country"/></t>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        Account Holder:
                                        <span t-esc="doc.company_id.partner_id.name"/>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        Sort Code:
                                        <span t-esc="company_bank and company_bank.acc_number or ''"/>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        Swift Code:
                                        <span t-esc="swift_code"/>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        Account Number:
                                        <span t-esc="doc.partner_bank_id.acc_number or ''"/>
                                    </div>

                                    <div class="ex-export-bank-row">
                                        IBAN:
                                        <span t-esc="doc.partner_bank_id.acc_number or ''"/>
                                    </div>

                                    <div class="ex-export-sign-simple">
                                        <div class="ex-export-sign-company">
                                            for <span t-esc="doc.company_id.partner_id.name"/>
                                        </div>

                                        <div class="ex-export-sign-gap"/>

                                        <div class="ex-export-sign-text">Authorised Signatory</div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="ex-footer-note">
                            <div>SUBJECT TO UNITED KINGDOM JURISDICTION</div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- LAYOUT WRAPPER -->
    <template id="css_uk_invoice_report_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div t-attf-class="article o_report_layout_striped o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

</odoo>